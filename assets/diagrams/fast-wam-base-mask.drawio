<mxCell id="note" value="" style="whiteSpace=wrap;html=0;fontFamily=PingFang SC;fontSize=20;fontColor=#263748;strokeColor=none;fillColor=none;spacing=4;container=1;collapsible=0;rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#dfe7ee;" vertex="1" parent="1"><mxGeometry x="545" y="173" width="535" height="386" as="geometry"/></mxCell>
<mxCell id="c41" value="读法：看 a₁ 这一行" style="whiteSpace=wrap;html=0;fontFamily=PingFang SC;fontSize=20;fontColor=#263748;strokeColor=none;fillColor=none;spacing=4;align=left;verticalAlign=middle;fontSize=23;" vertex="1" parent="note"><mxGeometry x="20" y="16" width="495" height="40" as="geometry"/></mxCell>
<mxCell id="c42" value="a₁ 能读 f₀、a₁、aₕ；&#xa;不能读 f₁、fₕ。" style="whiteSpace=wrap;html=0;fontFamily=PingFang SC;fontSize=20;fontColor=#263748;strokeColor=none;fillColor=none;spacing=4;align=left;verticalAlign=middle;fontSize=22;" vertex="1" parent="note"><mxGeometry x="20" y="68" width="495" height="74" as="geometry"/></mxCell>
<mxCell id="c43" value="因此推理可移除所有未来视频 token。&#xa;只保留 f₀ 与动作 token，权限不变。" style="whiteSpace=wrap;html=0;fontFamily=PingFang SC;fontSize=20;fontColor=#263748;strokeColor=none;fillColor=none;spacing=4;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="note"><mxGeometry x="20" y="160" width="495" height="82" as="geometry"/></mxCell>
<mxCell id="c44" value="f₀ 的表示不依赖未来帧或动作，&#xa;所以可单次计算并缓存各层 K/V。" style="whiteSpace=wrap;html=0;fontFamily=PingFang SC;fontSize=20;fontColor=#263748;strokeColor=none;fillColor=none;spacing=4;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="note"><mxGeometry x="20" y="270" width="495" height="76" as="geometry"/></mxCell>
<mxCell id="c45" value="推理：f₀ 一次前向 → 缓存当前帧 K/V → 动作多步去噪" style="whiteSpace=wrap;html=0;fontFamily=PingFang SC;fontSize=20;fontColor=#263748;strokeColor=none;fillColor=none;spacing=4;rounded=1;arcSize=15;fillColor=#edf3f8;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="35" y="590" width="1045" height="58" as="geometry"/></mxCell>
<mxCell id="c46" value="1 = 允许读取；0 = 屏蔽。颜色区分视频行（蓝）与动作行（黄）。" style="whiteSpace=wrap;html=0;fontFamily=PingFang SC;fontSize=20;fontColor=#263748;strokeColor=none;fillColor=none;spacing=4;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="35" y="666" width="1045" height="30" as="geometry"/></mxCell>
<mxCell id="c47" value="f₀：当前帧；f₁…fₕ：未来帧；a₁…aₕ：动作块。每格代表一组 token。" style="whiteSpace=wrap;html=0;fontFamily=PingFang SC;fontSize=20;fontColor=#263748;strokeColor=none;fillColor=none;spacing=4;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="35" y="703" width="1045" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
