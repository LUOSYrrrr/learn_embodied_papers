<mxfile host="app.diagrams.net" agent="Codex" version="24.7.17">
  <diagram id="fast-wam-idm" name="Fast-WAM-IDM">
    <mxGraphModel dx="1440" dy="1120" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1120" math="0" shadow="0" background="#ffffff" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Fast-WAM-IDM｜先想出未来，再生成动作" style="text;html=0;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=30;fontStyle=1;fontColor=#213547;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1360" height="50" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="读图顺序：① 先生成未来 latent　→　② 再用当前＋预测未来指导动作。两次去噪顺序执行。" style="text;html=0;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=18;fontColor=#526477;" vertex="1" parent="1"><mxGeometry x="40" y="75" width="1360" height="40" as="geometry"/></mxCell>
        <mxCell id="phase1" value="① 推理第一阶段：生成未来视频 latent" style="swimlane;html=0;horizontal=1;startSize=46;rounded=1;arcSize=10;collapsible=0;container=1;recursiveResize=0;fillColor=#eaf3ff;swimlaneFillColor=#f8fbff;strokeColor=#4779ad;strokeWidth=1.5;align=left;spacingLeft=20;fontFamily=PingFang SC;fontSize=21;fontStyle=1;fontColor=#294b70;" vertex="1" parent="1"><mxGeometry x="30" y="135" width="1380" height="275" as="geometry"/></mxCell>
        <mxCell id="p1_current" value="当前帧 → 冻结 VAE&#xa;x_cur：干净当前帧 latent&#xa;语言 ℓ：文本编码结果" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#f2eafa;strokeColor=#8a66a7;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=17;fontColor=#483458;spacing=10;" vertex="1" parent="phase1"><mxGeometry x="30" y="75" width="240" height="120" as="geometry"/></mxCell>
        <mxCell id="p1_noise" value="未来 latent 的&#xa;随机噪声 z₁" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#4779ad;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=18;fontColor=#294b70;" vertex="1" parent="phase1"><mxGeometry x="340" y="120" width="190" height="80" as="geometry"/></mxCell>
        <mxCell id="p1_video" value="Video DiT 多步 flow&#xa;z₁ → z_τ → z₀&#xa;每步预测 velocity，再更新 latent" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#eaf3ff;strokeColor=#4779ad;strokeWidth=2;fontFamily=PingFang SC;fontSize=18;fontColor=#294b70;spacing=10;" vertex="1" parent="phase1"><mxGeometry x="620" y="95" width="330" height="130" as="geometry"/></mxCell>
        <mxCell id="p1_future" value="预测未来 latent ẑ&#xa;包含未来状态／变化的信息&#xa;此时尚未生成动作" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#eaf3ff;strokeColor=#4779ad;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=18;fontColor=#294b70;spacing=10;" vertex="1" parent="phase1"><mxGeometry x="1050" y="100" width="290" height="120" as="geometry"/></mxCell>
        <mxCell id="p1_condition" value="条件" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#8a66a7;strokeWidth=2;fontFamily=PingFang SC;fontSize=16;fontColor=#6a4a83;exitX=1;exitY=0.2;entryX=0.5;entryY=0;" edge="1" parent="phase1" source="p1_current" target="p1_video"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="290" y="99"/><mxPoint x="290" y="70"/><mxPoint x="785" y="70"/></Array></mxGeometry></mxCell>
        <mxCell id="p1_noise_edge" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#4779ad;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="phase1" source="p1_noise" target="p1_video"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_output_edge" value="τ：1 → 0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#4779ad;strokeWidth=2;fontFamily=PingFang SC;fontSize=16;fontColor=#294b70;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="phase1" source="p1_video" target="p1_future"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_note" value="视频分支不读取动作。图中 τ 是去噪时间；不是视频的第几帧。" style="text;html=0;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=16;fontColor=#526477;" vertex="1" parent="phase1"><mxGeometry x="30" y="230" width="1250" height="30" as="geometry"/></mxCell>
        <mxCell id="phase2" value="② 推理第二阶段：以预测未来为条件，生成动作" style="swimlane;html=0;horizontal=1;startSize=46;rounded=1;arcSize=10;collapsible=0;container=1;recursiveResize=0;fillColor=#fff1df;swimlaneFillColor=#fffaf4;strokeColor=#bf7c28;strokeWidth=1.5;align=left;spacingLeft=20;fontFamily=PingFang SC;fontSize=21;fontStyle=1;fontColor=#865417;" vertex="1" parent="1"><mxGeometry x="30" y="440" width="1380" height="285" as="geometry"/></mxCell>
        <mxCell id="p2_noise" value="动作块的随机噪声 a₁&#xa;不是已经确定的机器人动作" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#bf7c28;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=18;fontColor=#865417;spacing=10;" vertex="1" parent="phase2"><mxGeometry x="30" y="135" width="310" height="90" as="geometry"/></mxCell>
        <mxCell id="p2_action" value="Action DiT 多步 flow&#xa;a₁ → a_τ → a₀&#xa;动作 Q 读取视觉 K/V 与动作 K/V" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#fff1df;strokeColor=#bf7c28;strokeWidth=2;fontFamily=PingFang SC;fontSize=18;fontColor=#865417;spacing=10;" vertex="1" parent="phase2"><mxGeometry x="510" y="120" width="410" height="115" as="geometry"/></mxCell>
        <mxCell id="p2_cache" value="视觉条件 K/V（可缓存）&#xa;当前帧＋预测未来的特征" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#eaf3ff;strokeColor=#4779ad;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=17;fontColor=#294b70;spacing=10;" vertex="1" parent="phase2"><mxGeometry x="1050" y="60" width="290" height="80" as="geometry"/></mxCell>
        <mxCell id="p2_chunk" value="动作 chunk a₀&#xa;交给机器人执行" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#fff1df;strokeColor=#bf7c28;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=18;fontColor=#865417;" vertex="1" parent="phase2"><mxGeometry x="1050" y="175" width="290" height="75" as="geometry"/></mxCell>
        <mxCell id="p2_lang" value="语言 ℓ 仍作为条件" style="text;html=0;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=17;fontColor=#8a66a7;" vertex="1" parent="phase2"><mxGeometry x="30" y="75" width="370" height="35" as="geometry"/></mxCell>
        <mxCell id="p2_noise_edge" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#bf7c28;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="phase2" source="p2_noise" target="p2_action"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_cond_edge" value="动作读取预测未来" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#4779ad;strokeWidth=2;fontFamily=PingFang SC;fontSize=16;fontColor=#294b70;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="phase2" source="p2_cache" target="p2_action"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="715" y="100"/></Array></mxGeometry></mxCell>
        <mxCell id="p2_output_edge" value="τ：1 → 0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#bf7c28;strokeWidth=2;fontFamily=PingFang SC;fontSize=16;fontColor=#865417;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="phase2" source="p2_action" target="p2_chunk"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_note" value="流程直接使用 latent／特征；无需先解码成 RGB 再编码。VAE Decoder 可另用于观看预测视频。" style="text;html=0;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=16;fontColor=#526477;" vertex="1" parent="phase2"><mxGeometry x="30" y="245" width="990" height="30" as="geometry"/></mxCell>
        <mxCell id="handoff" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#4779ad;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1_future" target="p2_cache"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="train" value="训练怎样做？损失都是 flow matching，但未来条件与部署时不同" style="swimlane;html=0;horizontal=1;startSize=45;rounded=1;arcSize=10;collapsible=0;container=1;recursiveResize=0;fillColor=#edf1f5;swimlaneFillColor=#fafbfc;strokeColor=#b5c1ce;strokeWidth=1.2;align=left;spacingLeft=20;fontFamily=PingFang SC;fontSize=20;fontStyle=1;fontColor=#34495e;" vertex="1" parent="1"><mxGeometry x="30" y="750" width="1380" height="195" as="geometry"/></mxCell>
        <mxCell id="train_video" value="视频：真实未来 latent 加噪 → 预测视频 velocity → L_vid&#xa;动作：真实动作加噪 → 预测动作 velocity → L_act" style="text;html=0;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=18;fontColor=#34495e;spacing=4;" vertex="1" parent="train"><mxGeometry x="25" y="55" width="760" height="75" as="geometry"/></mxCell>
        <mxCell id="train_loss" value="L_total = L_act + λ L_vid&#xa;两种任务一起训练两个专家" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#b5c1ce;fontFamily=PingFang SC;fontSize=19;fontColor=#34495e;" vertex="1" parent="train"><mxGeometry x="940" y="60" width="405" height="65" as="geometry"/></mxCell>
        <mxCell id="train_note" value="IDM 训练的动作条件来自真实未来 token；以 p = 0.5 做加噪增强。推理改用生成未来，增强用于缓解这种差异。&#xa;训练无需每个样本都先完整生成一段未来视频；动作分支通过真实动作的 velocity 目标学习控制。" style="text;html=0;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=16;fontColor=#526477;spacing=4;" vertex="1" parent="train"><mxGeometry x="25" y="130" width="1320" height="55" as="geometry"/></mxCell>
        <mxCell id="meaning" value="名字与注意力：别把两个概念混在一起" style="swimlane;html=0;horizontal=1;startSize=40;rounded=1;arcSize=10;collapsible=0;container=1;recursiveResize=0;fillColor=#f2eafa;swimlaneFillColor=#fcfaff;strokeColor=#8a66a7;strokeWidth=1.2;align=left;spacingLeft=20;fontFamily=PingFang SC;fontSize=20;fontStyle=1;fontColor=#62427a;" vertex="1" parent="1"><mxGeometry x="30" y="970" width="1380" height="120" as="geometry"/></mxCell>
        <mxCell id="meaning_text" value="IDM：p(a | 当前，预测未来，语言)，由状态变化推断该怎么动；不等于求解刚体关节动力学方程。&#xa;语言 cross-attention：视觉／动作查询文本。视频—动作交互：动作通过共享 attention 读取视觉 K/V。" style="text;html=0;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=17;fontColor=#483458;spacing=4;" vertex="1" parent="meaning"><mxGeometry x="25" y="45" width="1320" height="65" as="geometry"/></mxCell>
        <mxCell id="source_note" value="依据 arXiv:2603.16666v2 §3–4 的 IDM 变体绘制；不是后续 Optional IDM 双模式版。" style="text;html=0;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;fontColor=#697c8d;" vertex="1" parent="1"><mxGeometry x="40" y="1095" width="1360" height="22" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
