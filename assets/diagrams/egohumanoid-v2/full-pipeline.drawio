<mxGraphModel adaptiveColors="auto" page="1" pageWidth="1200" pageHeight="1675"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="EgoHumanoid-V2 完整流程（解释图，非论文原图）" style="text;html=0;fontSize=29;align=left;" vertex="1" parent="1"><mxGeometry x="45" y="15" width="1110" height="55" as="geometry"/></mxCell><mxCell id="capture" value="01 人体采集 · 没有机器人遥操作" style="swimlane;html=0;startSize=58;horizontal=1;fontSize=23;rounded=1;fillColor=#eaf3ff;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="25" y="95" width="1150" height="175" as="geometry"/></mxCell><mxCell id="offline" value="02 离线制作训练数据" style="swimlane;html=0;startSize=58;horizontal=1;fontSize=23;rounded=1;fillColor=#fff6e5;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="25" y="300" width="1150" height="610" as="geometry"/></mxCell><mxCell id="training" value="03 训练任务专用 VLA" style="swimlane;html=0;startSize=58;horizontal=1;fontSize=23;rounded=1;fillColor=#f0eefe;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="25" y="935" width="1150" height="280" as="geometry"/></mxCell><mxCell id="deployment" value="04 真机部署 · 闭环执行" style="swimlane;html=0;startSize=58;horizontal=1;fontSize=23;rounded=1;fillColor=#eaf7f0;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="25" y="1240" width="1150" height="295" as="geometry"/></mxCell><mxCell id="raw" value="人完成任务：PICO 记录身体 / 手部运动，GoPro 记录第一人称 RGB&#xa;同步记录 → 人体运动、手姿态、RGB；再配任务语言指令" style="rounded=1;whiteSpace=wrap;html=0;fontSize=21;spacing=12;strokeColor=#94a3b8;fontColor=#152334;fillColor=#ffffff;" vertex="1" parent="capture"><mxGeometry x="35" y="60" width="1080" height="80" as="geometry"/></mxCell><mxCell id="H" value="H · 人体运动 → SONIC 仿真 rollout&#xa;得到初始机器人关节轨迹、token 与骨盆高度" style="rounded=1;whiteSpace=wrap;html=0;fontSize=21;spacing=12;strokeColor=#94a3b8;fontColor=#152334;fillColor=#ffffff;" vertex="1" parent="offline"><mxGeometry x="35" y="95" width="650" height="70" as="geometry"/></mxCell><mxCell id="K" value="构造固定手 / 脚目标（含骨盆高度配准）&#xa;K · offline IK 改关节参考 → 编码为 SONIC token" style="rounded=1;whiteSpace=wrap;html=0;fontSize=21;spacing=12;strokeColor=#94a3b8;fontColor=#152334;fillColor=#fff1d8;" vertex="1" parent="offline"><mxGeometry x="35" y="205" width="650" height="85" as="geometry"/></mxCell><mxCell id="D" value="D · 冻结 decoder + MLP，优化 SONIC token&#xa;仿真 replay → 测执行残差 → 更新 context → 再优化&#xa;默认：7 轮常规 D + 1 轮保守 D" style="rounded=1;whiteSpace=wrap;html=0;fontSize=21;spacing=12;strokeColor=#94a3b8;fontColor=#152334;fillColor=#fff1d8;" vertex="1" parent="offline"><mxGeometry x="35" y="330" width="650" height="95" as="geometry"/></mxCell><mxCell id="select" value="历史候选选择 + 独立 replay 验收&#xa;保留通过验证的 token / 机器人状态；失败候选不直接入库" style="rounded=1;whiteSpace=wrap;html=0;fontSize=21;spacing=12;strokeColor=#94a3b8;fontColor=#152334;fillColor=#ffffff;" vertex="1" parent="offline"><mxGeometry x="35" y="465" width="650" height="85" as="geometry"/></mxCell><mxCell id="vision" value="RGB 视觉对齐&#xa;遮掉人体前臂与腕部 tracker&#xa;补全背景 → 渲染机器人臂&#xa;训练时再做图像增强" style="rounded=1;whiteSpace=wrap;html=0;fontSize=21;spacing=12;strokeColor=#94a3b8;fontColor=#152334;fillColor=#eaf3ff;" vertex="1" parent="offline"><mxGeometry x="735" y="95" width="380" height="145" as="geometry"/></mxCell><mxCell id="hands" value="手姿态重定向&#xa;人体手 → 左右 Revo2 手命令&#xa;每手 6 维" style="rounded=1;whiteSpace=wrap;html=0;fontSize=21;spacing=12;strokeColor=#94a3b8;fontColor=#152334;fillColor=#eaf3ff;" vertex="1" parent="offline"><mxGeometry x="735" y="330" width="380" height="95" as="geometry"/></mxCell><mxCell id="dataset" value="同步成监督样本：图像 + 43 维机器人状态 + 语言 → 76 维动作&#xa;动作 = 64 维 SONIC token + 左手 6 维 + 右手 6 维；状态来自验收 replay" style="rounded=1;whiteSpace=wrap;html=0;fontSize=21;spacing=12;strokeColor=#94a3b8;fontColor=#152334;fillColor=#ffffff;" vertex="1" parent="training"><mxGeometry x="35" y="55" width="1080" height="75" as="geometry"/></mxCell><mxCell id="train" value="以预训练 π₀.₅ 为起点，每个任务各自 post-train 一份策略&#xa;训练 VLA 参数；不把 SONIC / 响应 MLP 当作一起端到端训练的新模型" style="rounded=1;whiteSpace=wrap;html=0;fontSize=21;spacing=12;strokeColor=#94a3b8;fontColor=#152334;fillColor=#f0eefe;" vertex="1" parent="training"><mxGeometry x="35" y="175" width="1080" height="70" as="geometry"/></mxCell><mxCell id="obs" value="真实观测&#xa;机器人 GoPro RGB&#xa;机器人状态 + 指令" style="rounded=1;whiteSpace=wrap;html=0;fontSize=21;spacing=12;strokeColor=#94a3b8;fontColor=#152334;fillColor=#ffffff;" vertex="1" parent="deployment"><mxGeometry x="35" y="90" width="260" height="105" as="geometry"/></mxCell><mxCell id="policy" value="训练好的 VLA&#xa;预测动作序列&#xa;token + 双手命令" style="rounded=1;whiteSpace=wrap;html=0;fontSize=21;spacing=12;strokeColor=#94a3b8;fontColor=#152334;fillColor=#f0eefe;" vertex="1" parent="deployment"><mxGeometry x="340" y="90" width="210" height="105" as="geometry"/></mxCell><mxCell id="decode" value="身体 token → SONIC&#xa;双手命令 → Revo2&#xa;不是运行 K + 8D" style="rounded=1;whiteSpace=wrap;html=0;fontSize=21;spacing=12;strokeColor=#94a3b8;fontColor=#152334;fillColor=#fff1d8;" vertex="1" parent="deployment"><mxGeometry x="595" y="90" width="250" height="105" as="geometry"/></mxCell><mxCell id="robot" value="G1 实际执行&#xa;身体 + 双手&#xa;与环境交互" style="rounded=1;whiteSpace=wrap;html=0;fontSize=21;spacing=12;strokeColor=#94a3b8;fontColor=#152334;fillColor=#eaf7f0;" vertex="1" parent="deployment"><mxGeometry x="890" y="90" width="225" height="105" as="geometry"/></mxCell><mxCell id="edge0" value="" edge="1" parent="1" source="raw" target="H" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#64748b;fontSize=18;exitX=0.30092592592592593;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="" edge="1" parent="1" source="raw" target="vision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#64748b;fontSize=18;exitX=0.8240740740740741;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="" edge="1" parent="1" source="H" target="K" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#64748b;fontSize=18;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="" edge="1" parent="1" source="K" target="D" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#64748b;fontSize=18;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge4" value="" edge="1" parent="1" source="D" target="select" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#64748b;fontSize=18;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge5" value="" edge="1" parent="1" source="raw" target="hands" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#64748b;fontSize=18;exitX=1;exitY=0.5;entryX=1;entryY=0.49473684210526314;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1160" y="195"/><mxPoint x="1160" y="677"/></Array></mxGeometry></mxCell><mxCell id="edge6" value="" edge="1" parent="1" source="select" target="dataset" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#64748b;fontSize=18;exitX=0.5;exitY=1;entryX=0.30092592592592593;entryY=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge7" value="" edge="1" parent="1" source="vision" target="dataset" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#64748b;fontSize=18;exitX=0.5;exitY=1;entryX=0.8240740740740741;entryY=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="735" y="540"/><mxPoint x="735" y="890"/><mxPoint x="950" y="890"/></Array></mxGeometry></mxCell><mxCell id="edge8" value="" edge="1" parent="1" source="hands" target="dataset" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#64748b;fontSize=18;exitX=0.5;exitY=1;entryX=0.8240740740740741;entryY=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge9" value="" edge="1" parent="1" source="dataset" target="train" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#64748b;fontSize=18;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge10" value="" edge="1" parent="1" source="train" target="policy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#64748b;fontSize=18;exitX=0.37962962962962965;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge11" value="" edge="1" parent="1" source="obs" target="policy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#64748b;fontSize=18;exitX=1;exitY=0.49523809523809526;entryX=0;entryY=0.49523809523809526;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge12" value="" edge="1" parent="1" source="policy" target="decode" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#64748b;fontSize=18;exitX=1;exitY=0.49523809523809526;entryX=0;entryY=0.49523809523809526;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge13" value="" edge="1" parent="1" source="decode" target="robot" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#64748b;fontSize=18;exitX=1;exitY=0.49523809523809526;entryX=0;entryY=0.49523809523809526;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge14" value="下一次观测 / 自身状态反馈" edge="1" parent="1" source="robot" target="obs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#64748b;fontSize=18;exitX=0.5022222222222222;exitY=1;entryX=0.5;entryY=1;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1028" y="1490"/><mxPoint x="190" y="1490"/></Array></mxGeometry></mxCell><mxCell id="note" value="预先准备：已有 SONIC；响应 MLP 另行训练并冻结。&#xa;附录 D 独立对照：SONIC 命令 → online IK 覆盖/叠加部分关节 → 仿真；不是主部署流程。" style="rounded=1;whiteSpace=wrap;html=0;fontSize=21;spacing=12;strokeColor=#94a3b8;fontColor=#152334;fillColor=#fff3f2;" vertex="1" parent="1"><mxGeometry x="25" y="1560" width="1150" height="90" as="geometry"/></mxCell></root></mxGraphModel>
