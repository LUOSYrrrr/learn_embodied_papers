A / B / C 规则组合关节命令&#xa;部分关节用 IK，其他关节保留 SONIC；B 再加平衡贡献" style="rounded=1;whiteSpace=wrap;html=0;fontSize=21;fillColor=#ffe5df;strokeColor=#94a3b8;fontColor=#152334;" vertex="1" parent="1"><mxGeometry x="220" y="620" width="760" height="105" as="geometry"/></mxCell><mxCell id="sim" value="发送组合后的关节目标 → 仿真机器人执行&#xa;这里已经不是原封不动的 SONIC 输出" style="rounded=1;whiteSpace=wrap;html=0;fontSize=21;fillColor=#eaf7f0;strokeColor=#94a3b8;fontColor=#152334;" vertex="1" parent="1"><mxGeometry x="220" y="820" width="760" height="85" as="geometry"/></mxCell><mxCell id="measure" value="测量实际身体状态与手 / 脚位置&#xa;记录末端误差、身体倾角、初始化摔倒与 fall events" style="rounded=1;whiteSpace=wrap;html=0;fontSize=21;fillColor=#eaf7f0;strokeColor=#94a3b8;fontColor=#152334;" vertex="1" parent="1"><mxGeometry x="220" y="990" width="760" height="95" as="geometry"/></mxCell><mxCell id="e0" edge="1" parent="1" source="token" target="sonic" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#64748b;exitX=0.5;exitY=1;entryX=0.31;entryY=0;"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e1" edge="1" parent="1" source="state" target="sonic" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#64748b;exitX=0.5;exitY=1;entryX=1;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="595" y="335"/></Array></mxGeometry></mxCell><mxCell id="e2" edge="1" parent="1" source="state" target="ik" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#64748b;exitX=0.5;exitY=1;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="595" y="335"/></Array></mxGeometry></mxCell><mxCell id="e3" edge="1" parent="1" source="target" target="ik" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#64748b;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="980" y="245"/><mxPoint x="910" y="245"/></Array></mxGeometry></mxCell><mxC