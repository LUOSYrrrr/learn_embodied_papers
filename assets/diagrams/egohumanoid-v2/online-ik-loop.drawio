170" y="85"/><mxPoint x="595" y="85"/></Array></mxGeometry></mxCell><mxCell id="title" value="Online IK：执行当下组合关节命令（解释图，非论文原图）" style="rounded=1;whiteSpace=wrap;html=0;fontSize=23;fillColor=#f5f7fa;" vertex="1" parent="1"><mxGeometry x="60" y="10" width="1080" height="70" as="geometry"/></mxCell><mxCell id="variants" value="Table 11：A 手臂+腰 / 双腿由 IK 控制；B 在 A 上加 SONIC balance contribution；C 仅手臂 / 右腿由 IK 控制。其余关节由 SONIC 控制。" style="rounded=1;whiteSpace=wrap;html=0;fontSize=23;fillColor=#f5f7fa;" vertex="1" parent="1"><mxGeometry x="60" y="1145" width="1080" height="200" as="geometry"/></mxCell><mxCell id="boundary" value="附录 D 的独立仿真诊断，不是 VLA 推理流程。K 改参考再经 SONIC；online IK 改发送的关节命令。" style="rounded=1;whiteSpace=wrap;html=0;fontSize=23;fillColor=#f5f7fa;" vertex="1" parent="1"><mxGeometry x="60" y="1370" width="1080" height="75" as="geometry"/></mxCell></root></mxGraphModel>
