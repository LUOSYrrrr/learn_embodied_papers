<mxCell id="c41" value="读法：看 a₁ 这一行" style="whiteSpace=wrap;html=0;fontFamily=PingFang SC;fontSize=20;fontColor=#263748;strokeColor=none;fillColor=none;spacing=4;align=left;verticalAlign=middle;fontSize=23;" vertex="1" parent="note"><mxGeometry x="20" y="16" width="495" height="40" as="geometry"/></mxCell>
<mxCell id="c42" value="a₁ 能读当前帧、所有未来帧、&#xa;以及动作块中的其他动作 token。" style="whiteSpace=wrap;html=0;fontFamily=PingFang SC;fontSize=20;fontColor=#263748;strokeColor=none;fillColor=none;spacing=4;align=left;verticalAlign=middle;fontSize=21;" vertex="1" parent="note"><mxGeometry x="20" y="68" width="495" height="76" as="geometry"/></mxCell>
<mxCell id="c43" value="但反方向不开放：&#xa;f₁ / fₕ 不读取 a₁ / aₕ。" style="whiteSpace=wrap;html=0;fontFamily=PingFang SC;fontSize=20;fontColor=#263748;strokeColor=none;fillColor=none;spacing=4;align=left;verticalAlign=middle;fontSize=21;" vertex="1" parent="note"><mxGeometry x="20" y="161" width="495" height="77" as="geometry"/></mxCell>
<mxCell id="c44" value="每轮同时更新视频与动作：&#xa;视频仍在变，动作条件也随之变化。" style="whiteSpace=wrap;html=0;fontFamily=PingFang SC;fontSize=20;fontColor=#263748;strokeColor=none;fillColor=none;spacing=4;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="note"><mxGeometry x="20" y="271" width="495" height="75" as="geometry"/></mxCell>
<mxCell id="c45" value="推理：视频噪声 + 动作噪声 → 同步多步更新 → 视频 + 动作" style="whiteSpace=wrap;html=0;fontFamily=PingFang SC;fontSize=20;fontColor=#263748;strokeColor=none;fillColor=none;spacing=4;rounded=1;arcSize=15;fillColor=#edf3f8;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="35" y="590" width="1045" height="58" as="geometry"/></mxCell>
<mxCell id="c46" value="1 = 允许读取；0 = 屏蔽。颜色区分视频行（蓝）与动作行（黄）。" style="whiteSpace=wrap;html=0;fontFamily=PingFang SC;fontSize=20;fontColor=#263748;strokeColor=none;fillColor=none;spacing=4;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="35" y="666" width="1045" height="30" as="geometry"/></mxCell>
<mxCell id="c47" value="f₀：当前帧；f₁…fₕ：未来帧；a₁…aₕ：动作块。每格代表一组 token。" style="whiteSpace=wrap;html=0;fontFamily=PingFang SC;fontSize=20;fontColor=#263748;strokeColor=none;fillColor=none;spacing=4;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="35" y="703" width="1045" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
