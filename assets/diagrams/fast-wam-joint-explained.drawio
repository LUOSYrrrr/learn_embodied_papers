<mxCell id="title" value="Fast-WAM-Joint｜视频与动作一起去噪" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=30;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1360" height="48" as="geometry"/></mxCell>
<mxCell id="subtitle" value="同一轮里，动作读取当前及未来视频特征；视频不读取动作。两路同步去噪。" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontColor=#52657a;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="1360" height="35" as="geometry"/></mxCell>
<mxCell id="train" value="" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;container=1;collapsible=0;rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#d7e0e9;" vertex="1" parent="1"><mxGeometry x="40" y="125" width="1360" height="470" as="geometry"/></mxCell>
<mxCell id="train-title" value="训练｜抽一次噪声时刻 τ，同时练习视频去噪和动作去噪" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="train"><mxGeometry x="24" y="12" width="1305" height="35" as="geometry"/></mxCell>
<mxCell id="tv-input" value="未来 latent z* + 噪声 εᵥ&#xa;zτ = (1−τ) z* + τ εᵥ" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;rounded=1;arcSize=12;fillColor=#eaf3ff;strokeColor=#4779ad;fontSize=17;" vertex="1" parent="train"><mxGeometry x="325" y="65" width="250" height="75" as="geometry"/></mxCell>
<mxCell id="ta-input" value="真实动作 A* + 噪声 εₐ&#xa;Aτ = (1−τ) A* + τ εₐ" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;rounded=1;arcSize=12;fillColor=#fff1df;strokeColor=#bf7c28;fontSize=17;" vertex="1" parent="train"><mxGeometry x="805" y="65" width="250" height="75" as="geometry"/></mxCell>
<mxCell id="current" value="当前帧 latent x_cur&#xa;VAE 编码后保持干净&#xa;作为观测条件" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;rounded=1;arcSize=12;fillColor=#eaf3ff;strokeColor=#4779ad;fontSize=17;" vertex="1" parent="train"><mxGeometry x="25" y="185" width="220" height="90" as="geometry"/></mxCell>
<mxCell id="lang" value="文本编码 ℓ&#xa;两支读取同一语言条件" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;rounded=1;arcSize=12;fillColor=#f2eafa;strokeColor=#8a66a7;fontSize=17;" vertex="1" parent="train"><mxGeometry x="1115" y="185" width="220" height="90" as="geometry"/></mxCell>
<mxCell id="network" value="" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;container=1;collapsible=0;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#9dadbf;dashed=1;" vertex="1" parent="train"><mxGeometry x="285" y="165" width="790" height="130" as="geometry"/></mxCell>
<mxCell id="net-title" value="一轮联合网络计算" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontColor=#63778d;" vertex="1" parent="network"><mxGeometry x="20" y="5" width="750" height="25" as="geometry"/></mxCell>
<mxCell id="video" value="Video DiT&#xa;处理当前 + 未来 video tokens" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;rounded=1;arcSize=12;fillColor=#eaf3ff;strokeColor=#4779ad;fontSize=17;fontStyle=1;" vertex="1" parent="network"><mxGeometry x="40" y="43" width="230" height="65" as="geometry"/></mxCell>
<mxCell id="action" value="Action DiT&#xa;处理 action tokens" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;rounded=1;arcSize=12;fillColor=#fff1df;strokeColor=#bf7c28;fontSize=17;fontStyle=1;" vertex="1" parent="network"><mxGeometry x="520" y="43" width="230" height="65" as="geometry"/></mxCell>
<mxCell id="exchange" value="共享注意力&#xa;video → action" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;align=center;" vertex="1" parent="network"><mxGeometry x="282" y="36" width="226" height="52" as="geometry"/></mxCell>
<mxCell id="tv-n" value="" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#65778c;strokeColor=#4779ad;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="train" source="tv-input" target="video"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="ta-n" value="" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#65778c;strokeColor=#bf7c28;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="train" source="ta-input" target="action"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="cur-n" value="" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#65778c;strokeColor=#4779ad;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="train" source="current" target="video"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="lang-a" value="" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#65778c;strokeColor=#8a66a7;dashed=1;exitX=0;exitY=0.65;entryX=1;entryY=0.65;" edge="1" parent="train" source="lang" target="action"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="lang-v" value="" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#65778c;strokeColor=#8a66a7;dashed=1;exitX=0.5;exitY=0;entryX=0.85;entryY=0;" edge="1" parent="train" source="lang" target="video"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1225" y="155"/><mxPoint x="520" y="155"/></Array></mxGeometry></mxCell>
<mxCell id="va" value="" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#65778c;startArrow=none;strokeColor=#60758d;exitX=1;exitY=0.85;entryX=0;entryY=0.85;" edge="1" parent="network" source="video" target="action"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="uv" value="视频 flow 预测 ûᵥ&#xa;L_vid = MSE(ûᵥ, εᵥ − z*)" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;rounded=1;arcSize=12;fillColor=#eaf3ff;strokeColor=#4779ad;fontSize=17;" vertex="1" parent="train"><mxGeometry x="325" y="325" width="250" height="70" as="geometry"/></mxCell>
<mxCell id="ua" value="动作 flow 预测 ûₐ&#xa;L_act = MSE(ûₐ, εₐ − A*)" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;rounded=1;arcSize=12;fillColor=#fff1df;strokeColor=#bf7c28;fontSize=17;" vertex="1" parent="train"><mxGeometry x="805" y="325" width="250" height="70" as="geometry"/></mxCell>
<mxCell id="v-out" value="" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#65778c;strokeColor=#4779ad;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="train" source="video" target="uv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="a-out" value="" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#65778c;strokeColor=#bf7c28;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="train" source="action" target="ua"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="loss" value="总损失 L = L_act + λ L_vid   →   反向传播，更新可训练参数" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#b7c4d1;fontSize=17;fontSize=18;" vertex="1" parent="train"><mxGeometry x="350" y="420" width="680" height="35" as="geometry"/></mxCell>
<mxCell id="vloss" value="" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#65778c;strokeColor=#4779ad;exitX=0.5;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="train" source="uv" target="loss"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="aloss" value="" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#65778c;strokeColor=#bf7c28;exitX=0.5;exitY=1;entryX=0.8;entryY=0;" edge="1" parent="train" source="ua" target="loss"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="train-note" value="一次训练样本：&#xa;抽 τ、加噪、预测 flow。&#xa;不必完整生成一遍视频。" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontColor=#52657a;" vertex="1" parent="train"><mxGeometry x="25" y="332" width="255" height="85" as="geometry"/></mxCell>
<mxCell id="vae-note" value="z* 来自未来真实帧&#xa;经冻结 VAE 编码。&#xa;损失在 latent 空间计算。" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontColor=#52657a;" vertex="1" parent="train"><mxGeometry x="1115" y="332" width="220" height="85" as="geometry"/></mxCell>
<mxCell id="infer" value="" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;container=1;collapsible=0;rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#d7e0e9;" vertex="1" parent="1"><mxGeometry x="40" y="625" width="1360" height="270" as="geometry"/></mxCell>
<mxCell id="infer-title" value="推理｜两路同时从噪声出发，每轮一起更新，直到得到视频 latent 和动作" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="infer"><mxGeometry x="24" y="12" width="1305" height="35" as="geometry"/></mxCell>
<mxCell id="initial" value="同时初始化&#xa;视频噪声 z₁ ~ N(0,I)&#xa;动作噪声 A₁ ~ N(0,I)" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#b7c4d1;fontSize=17;" vertex="1" parent="infer"><mxGeometry x="25" y="90" width="250" height="95" as="geometry"/></mxCell>
<mxCell id="iteration" value="" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;container=1;collapsible=0;rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#9dadbf;" vertex="1" parent="infer"><mxGeometry x="330" y="65" width="565" height="145" as="geometry"/></mxCell>
<mxCell id="it-title" value="每一轮：当前帧 + 文本 + zτ + Aτ → 两个 DiT" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="iteration"><mxGeometry x="16" y="8" width="533" height="32" as="geometry"/></mxCell>
<mxCell id="iv" value="预测视频 ûᵥ&#xa;zτ−Δτ = zτ − Δτ · ûᵥ" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;rounded=1;arcSize=12;fillColor=#eaf3ff;strokeColor=#4779ad;fontSize=17;" vertex="1" parent="iteration"><mxGeometry x="20" y="51" width="250" height="62" as="geometry"/></mxCell>
<mxCell id="ia" value="预测动作 ûₐ&#xa;Aτ−Δτ = Aτ − Δτ · ûₐ" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;rounded=1;arcSize=12;fillColor=#fff1df;strokeColor=#bf7c28;fontSize=17;" vertex="1" parent="iteration"><mxGeometry x="294" y="51" width="250" height="62" as="geometry"/></mxCell>
<mxCell id="it-foot" value="反复执行；τ 从 1 走到 0（图中用简单 Euler 更新示意）" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#63778d;" vertex="1" parent="iteration"><mxGeometry x="16" y="113" width="535" height="26" as="geometry"/></mxCell>
<mxCell id="z-final" value="最终未来 latent ẑ₀&#xa;VAE Decode → 视频（仅可视化）" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;rounded=1;arcSize=12;fillColor=#eaf3ff;strokeColor=#4779ad;fontSize=17;" vertex="1" parent="infer"><mxGeometry x="965" y="65" width="365" height="70" as="geometry"/></mxCell>
<mxCell id="a-final" value="最终动作 chunk Â₀&#xa;用于机器人控制" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;rounded=1;arcSize=12;fillColor=#fff1df;strokeColor=#bf7c28;fontSize=17;" vertex="1" parent="infer"><mxGeometry x="965" y="165" width="365" height="70" as="geometry"/></mxCell>
<mxCell id="noise-it" value="" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#65778c;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="infer" source="initial" target="iteration"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="it-v" value="" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#65778c;strokeColor=#4779ad;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="infer" source="iteration" target="z-final"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="it-a" value="" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#65778c;strokeColor=#bf7c28;exitX=1;exitY=0.85;entryX=0;entryY=0.5;" edge="1" parent="infer" source="iteration" target="a-final"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="infer-note" value="动作读取的是同轮未来 token 的去噪状态；不需要先把 latent 解码为 RGB 视频。" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontColor=#52657a;" vertex="1" parent="infer"><mxGeometry x="330" y="225" width="990" height="28" as="geometry"/></mxCell>
<mxCell id="notes" value="" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;container=1;collapsible=0;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#d7e0e9;" vertex="1" parent="1"><mxGeometry x="40" y="925" width="1360" height="155" as="geometry"/></mxCell>
<mxCell id="notes-title" value="读图时分清两种 attention" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=21;fontStyle=1;" vertex="1" parent="notes"><mxGeometry x="24" y="12" width="1305" height="32" as="geometry"/></mxCell>
<mxCell id="text-attn" value="语言 cross-attention&#xa;视频 / 动作提供 Q，文本编码提供 K、V。" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;rounded=1;arcSize=12;fillColor=#f2eafa;strokeColor=#8a66a7;fontSize=17;" vertex="1" parent="notes"><mxGeometry x="25" y="60" width="610" height="72" as="geometry"/></mxCell>
<mxCell id="shared-attn" value="共享注意力：视频 → 动作（单向）&#xa;当前只读当前；未来读当前＋未来；动作读全部视频。&#xa;视频不读动作；两套 DiT 参数独立。" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#233247;strokeWidth=1.5;spacing=8;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#b7c4d1;fontSize=17;" vertex="1" parent="notes"><mxGeometry x="690" y="60" width="640" height="72" as="geometry"/></mxCell>
<mxCell id="source-note" value="流程：arXiv:2603.16666v2 §3–4；Joint mask：当前官方 main 默认配置核对（2026-10-13）" style="html=0;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#63778d;strokeColor=none;fillColor=none;fontSize=14;align=left;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="1090" width="1360" height="22" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
