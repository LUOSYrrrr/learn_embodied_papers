<mxfile host="app.diagrams.net" version="26.0.0"><diagram id="fast-wam-joint" name="Joint"><mxGraphModel dx="1440" dy="1120" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1120" math="0" shadow="0" background="#ffffff" adaptiveColors="auto"><root>
